# Copy to .env and fill in. The harness reads BUZZ_RELAY_URL from config.yaml;
# per-identity BUZZ_PRIVATE_KEY is injected automatically from keys.json.

# Buzz relay the harness talks to
BUZZ_RELAY_URL=ws://localhost:3000

# Hosted provider serving deepseek-v4-flash-0731 (openai_compat backend only).
# If you use the hermes_cli backend, set the key via `hermes model` instead.
HERMES_MODEL_API_KEY=

# Refuse any event we can't fully signature-verify (recommended in production).
HARNESS_REQUIRE_SIG=1
