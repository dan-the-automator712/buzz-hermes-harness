# Optional environment for the bridge watcher.
# Copy to bridge/watcher.env (gitignored) and fill in what you need.

# If `hermes` isn't already on the systemd PATH, add its directory here:
# PATH=/home/dizcofuz/.cargo/bin:/home/dizcofuz/.local/bin:/usr/local/bin:/usr/bin:/bin

# Closed relay REST auth token (see harness/.env.example). Confirm the exact
# variable buzz-cli expects with `buzz --help`.
# BUZZ_AUTH_TOKEN=

# Refuse any event that can't be fully signature-verified.
# HARNESS_REQUIRE_SIG=1

# Poll interval / per-job timeout overrides:
# BRIDGE_POLL=5
# BRIDGE_JOB_TIMEOUT=3600
